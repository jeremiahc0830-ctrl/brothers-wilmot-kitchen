/* High-end rich warm wood texture background with dark ambient toning */
.wood-bg {
    background-color: #1a0f0a;
    background-image: 
        linear-gradient(to bottom, rgba(15, 10, 7, 0.85), rgba(20, 12, 8, 0.92)),
        url('https://images.unsplash.com/photo-1544816155-12df9643f363?q=80&w=1920&auto=format&fit=crop');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
}
